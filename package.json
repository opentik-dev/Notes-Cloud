{
  "name": "notescloud",
  "version": "1.0.0",
  "private": false,
  "description": "NotesCloud - دفتر سحابي powered by Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute notes-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute notes-db --remote --file=./schema.sql",
    "backup:local": "node scripts/backup.mjs --local",
    "backup:remote": "node scripts/backup.mjs --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
